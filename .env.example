# RefundGuard Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_super_secure_jwt_secret_key_here

# MongoDB Atlas Connection URI
# Obtain this from your MongoDB Atlas Dashboard -> Connect -> Drivers -> Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/refundguard?retryWrites=true&w=majority
