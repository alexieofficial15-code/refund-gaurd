# RefundGuard Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_super_secure_jwt_secret_key_here

# MongoDB Atlas Connection URI
# Obtain this from your MongoDB Atlas Dashboard -> Connect -> Drivers -> Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/refundguard?retryWrites=true&w=majority

# Default Administrator Credentials
ADMIN_EMAIL=admin@refundguard.org
ADMIN_PASSWORD=Password123!
ADMIN_ROLE=admin
ADMIN_NAME=System Administrator

# Registered Domain & Production URLs
DOMAIN_NAME=refundguard.com
APP_URL=https://refundguard.com

# Institutional SMTP Configuration (Ready for refundguard.com)
# When you purchase refundguard.com, simply set your email provider details below:
SMTP_HOST=mail.refundguard.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@refundguard.com
SMTP_PASS=your_email_password_here
SMTP_FROM_NAME=RefundGuard Restitution Bureau
SMTP_FROM_EMAIL=settlements@refundguard.com
